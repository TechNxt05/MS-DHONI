MONGODB_URI=your_mongodb_connection_string

# Free API: GNews (https://gnews.io/) - free tier key
GNEWS_API_KEY=your_gnews_api_key
GNEWS_QUERY=MS Dhoni OR Chennai Super Kings
GNEWS_COUNTRY=in
GNEWS_MAX_RESULTS=10

# AI evaluation for Fan Universe challenges
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# AI evaluation model override (optional)
GEMINI_MODEL=gemini-2.5-flash

# Daily "On this day" email (Vercel Cron, see vercel.json)
CRON_SECRET=any_long_random_string
GMAIL_USER=the.sending.address@gmail.com
GMAIL_APP_PASSWORD=sixteen_char_app_password
# Optional: addresses you add by hand. Site sign-ups are stored in MongoDB (MONGODB_URI).
DIGEST_RECIPIENTS=friend.one@example.com,friend.two@example.com
SITE_URL=https://ms-dhoni-website-seven.vercel.app
